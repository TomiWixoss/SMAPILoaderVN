<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFramework>net8.0-android</TargetFramework>
		<OutputType>Exe</OutputType>
		<ApplicationId>abc.smapi.gameloadervn</ApplicationId>
		<SupportedOSPlatformVersion>23.0</SupportedOSPlatformVersion>
		<AndroidSigningKeyStore>debug.keystore</AndroidSigningKeyStore>
		<PackageIcon>icon.png</PackageIcon>
		<Version></Version>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.1.4</ApplicationDisplayVersion>
		<ApplicationVersion>$([System.DateTimeOffset]::Now.ToUnixTimeSeconds())</ApplicationVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<!-- Android SDK Path -->
		<AndroidSdkDirectory>C:\Users\tomis\AppData\Local\Android\sdk</AndroidSdkDirectory>
		
		<!-- Enable desugaring for Java 8 features on API < 26 -->
		<AndroidDexTool>d8</AndroidDexTool>
		<AndroidEnableDesugar>true</AndroidEnableDesugar>
		<_AndroidAllowDuplicateTypes>true</_AndroidAllowDuplicateTypes>
		
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<PublishTrimmed>False</PublishTrimmed>
		<AndroidEnableSGenConcurrent>True</AndroidEnableSGenConcurrent>
		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidSigningStorePass>android</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>android</AndroidSigningKeyPass>
		<IsAotCompatible>False</IsAotCompatible>
		<AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
		<RunAOTCompilation>False</RunAOTCompilation>
	</PropertyGroup>
	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<AndroidEnableSGenConcurrent>True</AndroidEnableSGenConcurrent>
		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidSigningStorePass>android</AndroidSigningStorePass>
		<AndroidSigningKeyAlias>androiddebugkey</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>android</AndroidSigningKeyPass>
		<IsAotCompatible>False</IsAotCompatible>
		<AndroidEnableProfiledAot>False</AndroidEnableProfiledAot>
		<RunAOTCompilation>False</RunAOTCompilation>
		<EmbedAssembliesIntoApk>True</EmbedAssembliesIntoApk>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Mono.Cecil" Version="0.11.5">
			<Aliases>MonoCecilAlias</Aliases>
		</PackageReference>
		<PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
		<PackageReference Include="Octokit" Version="13.0.1" />
		<PackageReference Include="SkiaSharp" Version="2.88.9" />
		<PackageReference Include="System.IO.Compression" Version="4.3.0" />
		<PackageReference Include="Xamarin.AndroidX.AppCompat" Version="1.7.0.4" />
		<PackageReference Include="Xamarin.Essentials" Version="1.7.7" />
	</ItemGroup>
	
	<!-- Remove duplicate GeneratedPluginRegistrant class from Flutter AAR -->
	<Target Name="RemoveDuplicateGeneratedPluginRegistrant" AfterTargets="_ExtractLibraryProjectImports" BeforeTargets="_CompileToDalvik">
		<Message Text="Removing duplicate GeneratedPluginRegistrant classes..." Importance="high" />
		<Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;&amp; { $ErrorActionPreference = 'SilentlyContinue'; $jars = Get-ChildItem -Path '$(IntermediateOutputPath)lp' -Recurse -Filter 'classes.jar' | Where-Object { $_.FullName -match 'jl' }; foreach ($jar in $jars) { $tempDir = Join-Path $env:TEMP ([System.IO.Path]::GetRandomFileName()); New-Item -ItemType Directory -Path $tempDir -Force | Out-Null; Add-Type -AssemblyName System.IO.Compression.FileSystem; [System.IO.Compression.ZipFile]::ExtractToDirectory($jar.FullName, $tempDir); $dupClass = Get-ChildItem -Path $tempDir -Recurse -Filter 'GeneratedPluginRegistrant.class'; if ($dupClass) { Remove-Item $dupClass.FullName -Force; Remove-Item $jar.FullName -Force; [System.IO.Compression.ZipFile]::CreateFromDirectory($tempDir, $jar.FullName); Write-Host ('Removed GeneratedPluginRegistrant from ' + $jar.FullName); } Remove-Item $tempDir -Recurse -Force; } }&quot;" 
			  Condition="Exists('$(IntermediateOutputPath)lp')" 
			  ContinueOnError="true" 
			  IgnoreExitCode="true" />
	</Target>
	
	<ItemGroup>
		<ProjectReference Include="..\AssemblyStore\AssemblyStore.csproj" />
		<ProjectReference Include="..\FlutterBinding\FlutterBinding.csproj" />
	</ItemGroup>
	<ItemGroup>
		<Reference Include="0Harmony">
			<HintPath>..\SharedLibs\0Harmony.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.Backports">
			<HintPath>..\SharedLibs\MonoMod.Backports.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.Core">
			<HintPath>..\SharedLibs\MonoMod.Core.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.Iced">
			<HintPath>..\SharedLibs\MonoMod.Iced.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.ILHelpers">
			<HintPath>..\SharedLibs\MonoMod.ILHelpers.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.RuntimeDetour">
			<HintPath>..\SharedLibs\MonoMod.RuntimeDetour.dll</HintPath>
		</Reference>
		<Reference Include="MonoMod.Utils">
			<HintPath>..\SharedLibs\MonoMod.Utils.dll</HintPath>
		</Reference>
		<Reference Include="MonoGame.Framework">
			<HintPath>..\..\SMAPI-Android-1.6\src\DependenciesDll\MonoGame.Framework.dll</HintPath>
		</Reference>
		<Reference Include="StardewValley">
			<HintPath>..\..\SMAPI-Android-1.6\src\DependenciesDll\StardewValley.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="StardewValley.GameData">
			<HintPath>..\..\SMAPI-Android-1.6\src\DependenciesDll\StardewValley.GameData.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>
	<ItemGroup>
		<None Update="Resources\Drawable\icon.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
	<Target Name="RestoreDotnetTools" BeforeTargets="Restore">
		<Message Text="Restoring dotnet tools" Importance="High" />
		<Exec Command="dotnet tool restore" />
	</Target>
</Project>